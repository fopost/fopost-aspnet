<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Parent-from-source shim: FoPost.Sdk is not on NuGet yet, so CI packs it
         from fopost/fopost-dotnet into local-packages/. Delete this source and
         the folder once FoPost.Sdk 0.1.0 is published. -->
    <add key="fopost-local" value="local-packages" />
  </packageSources>
</configuration>
